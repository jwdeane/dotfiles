{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./instructions/bash-validation.md"],
  "autoupdate": true,
  "mcp": {
    "cf-agents": {
      "type": "remote",
      "url": "https://agents.cloudflare.com/mcp",
      "enabled": false,
    },
    "cf-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env.CLOUDFLARE_GLOBAL_RO}",
      },
    },
    "cf-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": false,
    },
    "cf-browser": {
      "type": "remote",
      "url": "https://browser.mcp.cloudflare.com/mcp",
      "enabled": false,
    },
    "cf-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false,
    },
    "terraform": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": false,
    },
  },
}
